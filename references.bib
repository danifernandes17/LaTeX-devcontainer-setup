@article{kelemen2000individual,
	title = {Individual differences in metacognition: {Evidence} against a general metacognitive ability},
	volume = {28},
	issn = {1532-5946},
	url = {https://doi.org/10.3758/BF03211579},
	doi = {10.3758/BF03211579},
	abstract = {Individual differences in metacognitive accuracy are generally thought to reflect differences in metacognitive ability. If so, memory monitoring performance should be consistent across different metacognitive tasks and show high test-retest reliability. Two experiments examined these possibilities, using four common metacognitive tasks: ease of learning judgments, feeling of knowing judgments, judgments of learning, and text comprehension monitoring. Alternate-forms correlations were computed for metacognitive accuracy (with a 1-week interval between tests). Although individual differences in memory and confidence were stable across both sessions and tasks, differences in metacognitive accuracy were not. These results pose considerable practical and theoretical challenges for metacognitive researchers.},
	number = {1},
	journal = {Memory \& Cognition},
	author = {Kelemen, William L. and Frost, Peter J. and Weaver, Charles A.},
	month = jan,
	year = {2000},
	pages = {92--107},
}

